{
  "name": "m6-viajes",
  "version": "0.1.0",
  "description": "M6 - Viajes y Ciclo de Vida (Grupo 5)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest && jest --config test/jest-e2e.json",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "contratos:validar": "redocly lint --config ../redocly.yaml ../contratos/m6-viajes.openapi.yaml && node scripts/validar-asyncapi.js ../contratos/eventos/m6-viajes.asyncapi.yaml",
    "token": "node scripts/generar-token.js",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:infra": "TEST_PERSISTENCIA=postgres TEST_RABBITMQ_URL=${TEST_RABBITMQ_URL:-amqp://m6:m6@localhost:5672} TEST_REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379} jest --config test/jest-e2e.json --runInBand",
    "db:consola": "docker compose exec postgres psql -U m6 -d m6_viajes",
    "docker:levantar": "docker compose up -d --build --wait",
    "docker:detener": "docker compose down",
    "docker:logs": "docker compose logs -f m6-viajes",
    "infra:levantar": "docker compose up -d --wait postgres rabbitmq redis",
    "infra:detener": "docker compose stop postgres rabbitmq redis"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "amqplib": "0.10.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@redocly/cli": "2.60.0",
    "@types/amqplib": "0.10.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "private": true,
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
