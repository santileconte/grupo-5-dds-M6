{
  "name": "m6-viajes",
  "version": "0.1.0",
  "description": "M6 - Viajes y Ciclo de Vida (Grupo 5)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contratos:validar": "redocly lint --config ../redocly.yaml ../contratos/m6-viajes.openapi.yaml && node scripts/validar-asyncapi.js ../contratos/eventos/m6-viajes.asyncapi.yaml"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@redocly/cli": "2.60.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "private": true,
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
