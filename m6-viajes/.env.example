# Copiar a .env y ajustar. Nunca subir .env al repositorio (RNF-06).

PUERTO=3000

# Secreto para verificar los JWT. Mientras M1 no emita tokens, `npm run token` firma tokens de
# desarrollo con este mismo valor. En cualquier entorno compartido usar un valor propio y largo.
JWT_SECRETO=secreto-de-desarrollo-cambiar-en-entornos-compartidos

# Dónde se guardan los viajes: "postgres" (levantar antes con `npm run infra:levantar`)
# o "memoria" (sin base; los datos se pierden al reiniciar).
PERSISTENCIA=postgres
BASE_DATOS_URL=postgres://m6:m6@localhost:5432/m6_viajes

# Adónde van los eventos: "rabbitmq" (levantar antes con `npm run infra:levantar`)
# o "log" (se muestran en la terminal, sin broker).
PUBLICADOR_EVENTOS=rabbitmq
RABBITMQ_URL=amqp://m6:m6@localhost:5672
# Cada cuántos ms el relevador revisa la bandeja de salida de eventos.
OUTBOX_INTERVALO_MS=1000

# Minutos que el conductor espera tras el arribo antes de cancelar por CLIENTE_NO_SE_PRESENTO.
ESPERA_MINIMA_ARRIBO_MINUTOS=5

# Validación del QR: "simulado" (el código válido es QR-<viajeId>) o "m8" (llama a M8 por HTTP).
VALIDADOR_QR=simulado
# M8_URL=http://localhost:3008
# M8_TIMEOUT_MS=2000
