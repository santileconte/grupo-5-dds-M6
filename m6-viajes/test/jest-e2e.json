{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/entorno.ts"
  ]
}
